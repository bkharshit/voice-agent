# Normal mode requires PostgreSQL. Copy to .env; never commit credentials.
VOICE_MODE=normal
VOICE_DATABASE_URL=postgresql+asyncpg://voice:voice@127.0.0.1:5432/voice
VOICE_DEFAULT_PROFILE=ollama-local
VOICE_PROFILES_PATH=config/profiles.json
VOICE_HOST=127.0.0.1
VOICE_PORT=8000
# Required when binding to a non-loopback address. The UI asks for this access key.
VOICE_API_KEY=
VOICE_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:5173"]
# Enable after installing the voice extra and provisioning Kokoro assets.
VOICE_AUDIO_BACKEND=browser
VOICE_WHISPER_MODEL=small.en
VOICE_WHISPER_LANGUAGE=en
VOICE_WHISPER_BEAM_SIZE=5
VOICE_VAD_STOP_SECONDS=0.9
VOICE_KOKORO_MODEL=.data/models/kokoro-v1.0.onnx
VOICE_KOKORO_VOICES=.data/models/voices-v1.0.bin
VOICE_KOKORO_VOICE=af_heart
# Configure these only for profiles you actually use.
OLLAMA_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=


# Independent speech providers; unset values follow VOICE_AUDIO_BACKEND.
# Server startup selection: browser, whisper, vosk.
# VOICE_STT_PROVIDER=vosk
# VOICE_TTS_PROVIDER=kokoro
VOICE_VOSK_MODEL=.data/models/vosk-model-small-en-us-0.15
